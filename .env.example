# Public URL of the deployed backend used during the frontend build.
VITE_API_URL=http://127.0.0.1:8000

# Comma-separated frontend origins allowed to call the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Absolute path or a path relative to the repository root.
DATABASE_PATH=backend/data/app.db

# Set to false in production when a prepared database is already available.
SEED_DATABASE_ON_STARTUP=true
