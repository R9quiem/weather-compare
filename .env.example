# Local frontend -> backend
VITE_API_URL=http://127.0.0.1:8000

# Docker frontend ports (not used by local Vite/Uvicorn)
APP_PORT=8080
HTTPS_PORT=443

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local PostgreSQL server; database and role must already exist.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weather
DB_USER=weather_app
DB_PASSWORD=

# SQLite source retained for migration / comparison; not used by Psycopg.
DATABASE_PATH=backend/data/app.db

# Keep automatic weather loading off while migrating.
SEED_DATABASE_ON_STARTUP=false
